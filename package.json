{
  "name": "event-payload-spillway",
  "version": "0.1.0",
  "description": "Encrypted overflow control for oversized webhook and event payload fields.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/B-Divyesh/sf-event-payload-spillway.git"
  },
  "homepage": "https://event-payload-spillway.sociobot.in",
  "keywords": [
    "webhook",
    "s3",
    "minio",
    "payload",
    "postgres",
    "encryption"
  ],
  "exports": {
    ".": {
      "types": "./dist/package/types/index.d.ts",
      "import": "./dist/package/esm/index.js",
      "require": "./dist/package/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/package/cjs/index.js",
  "module": "./dist/package/esm/index.js",
  "types": "./dist/package/types/index.d.ts",
  "files": [
    "dist/package",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite site --host 0.0.0.0 --port 4173",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/cjs-package.mjs",
    "build:types": "tsc -p tsconfig.types.json",
    "build:lib": "rm -rf dist/package && npm run build:esm && npm run build:cjs && npm run build:types",
    "build:site": "vite build --config vite.config.ts --outDir ../dist/site --emptyOutDir",
    "build": "npm run build:lib && npm run build:site",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:claims": "node scripts/verify-claims.mjs",
    "verify:browser": "node scripts/verify-browser.mjs",
    "verify:live-review": "node scripts/verify-live-review.mjs",
    "verify:deployment": "node scripts/verify-deployment-policy.mjs",
    "verify:pwa": "node scripts/verify-pwa.mjs",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "playwright": "1.58.2",
    "typescript": "5.9.2",
    "vite": "^7.3.6"
  }
}
